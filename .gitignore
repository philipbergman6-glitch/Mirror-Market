# Virtual environment
.venv/
venv/

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo

# Test / lint artifacts
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Data files (re-fetchable)
data/storage/*.db
data/storage/*.csv
data/storage/*.json

# Trusted-path reconciliation reports (scripts/reconcile_*.py).
# Kept as a CI artifact for the evaluation window, not as repo history —
# a daily JSON commit would be pure noise in data/.
data/reconciliation/

# Environment / secrets
.env

# OS
.DS_Store
.gstack/
.scratch/
graphify-out/
.claude/

# Local pitch materials (public repo — never commit)
pitch/

# Phase 4 — the private trader workflow and the private page render.
# The working file (status, owner, notes, contacts, outcomes) never leaves the
# machine it was written on, and the private edition of the opportunity board is
# rendered OUTSIDE docs/ so the Pages deploy cannot carry it. The README stays
# tracked; nothing else here does.
data/reference/opportunities/*.yml
data/reference/opportunities/*.yaml
data/workspace/

# Phase 5 — the trader validation trial. Session records carry a trader's own
# handle, decisions, notes and evidence; day observations carry the desk's read
# on what was broken that day. These are YAML files rather than a table for
# exactly this reason: every table in this project round-trips through
# data/history/*.csv, which is committed to this public repository, so a trial
# table would publish trader identity by construction. The README stays tracked;
# no record does. Generated private output lands in data/workspace/, above.
data/reference/trial/sessions/*.yml
data/reference/trial/sessions/*.yaml
data/reference/trial/days/*.yml
data/reference/trial/days/*.yaml

# Phase 6 — the client's own book. Positions, fills, clearing statements, option
# quotes and the broker column-mapping profiles that name their broker. These are
# the only records in this repository that belong to a client rather than to a
# public data source, and a published book is front-runnable. They are YAML/CSV
# files rather than tables for exactly the reason the trial records are: every
# table here round-trips through data/history/*.csv, which is committed to this
# public repository, so a positions table would publish the book by construction.
# The READMEs stay tracked; no record does.
data/reference/positions/*.yml
data/reference/positions/*.yaml
data/reference/positions/*.csv
data/reference/options/*.yml
data/reference/options/*.yaml
data/reference/options/*.csv
data/reference/clearing/*.yml
data/reference/clearing/*.yaml
data/reference/clearing/*.csv
data/reference/import_profiles/*.yml
data/reference/import_profiles/*.yaml
data/reference/import_profiles/*.csv

# Concurrent-session git worktrees (each is its own checkout, never content)
.worktrees/
