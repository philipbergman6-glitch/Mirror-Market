{# Shared market-surface CSS — imported by the page, brief and stub templates
   so the three tiers cannot drift apart visually. Kept out of _base.html.j2
   because the headline and players pages never render a block. #}
/* ---- tier stamp ---- */
.tier-stamp { display: flex; align-items: baseline; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 12px; color: var(--text-muted); flex-wrap: wrap; }
.tier-pill { font-family: var(--display); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 3px; background: var(--green); color: #fff; }
.tier-pill.brief { background: #E4E8E4; color: var(--text-muted); }
.tier-pill.stub { background: transparent; border: 1px solid var(--rule); color: var(--text-dim); }
.tier-why { color: var(--text-dim); }
.venue { font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }

{# `.kind` moved to _base.html.j2 with M19 #223: the headline ledger renders it
   too, and a second copy here is the drift the one-<head>-owner rule prevents. #}

/* ---- blocks ---- */
.block { padding: 22px 0; border-bottom: 1px solid var(--rule); }
.block:last-of-type { border-bottom: none; }
.block-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
.block-no { font-family: var(--mono); font-size: 12px; color: var(--green); font-weight: 500; }
.block-head h2 { font-family: var(--display); font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: 0.05em; }
.block-head .why { margin-left: auto; font-size: 12px; color: var(--text-dim); }
@media (max-width: 768px) {
  .tier-why { flex-basis: 100%; overflow-wrap: anywhere; }
  .block-head .why { flex-basis: 100%; margin-left: 0; overflow-wrap: anywhere; }
}

{# `.empty-state` moved to _base.html.j2 with M16 #208: the headline crush
   board renders it too, same one-owner rule as `.kind` above. #}

/* ---- river gauges (block 06, M25 #272 / M26 #273) ----
   DESIGN.md's "Key/value watch row": muted label left, mono value right,
   dotted rule between. Defined here rather than in _base.html.j2 because only
   a market block renders a river — the headline and players pages never do,
   which is the same reason this whole file exists. */
.river { margin-top: 14px; }
.river-head { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); margin-bottom: 4px; }
.river-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; padding: 6px 0; border-bottom: 1px dotted var(--rule); font-size: 13px; align-items: baseline; }
.river-row:last-child { border-bottom: none; }
.river-row .lbl { color: var(--text-muted); min-width: 0; overflow-wrap: anywhere; }
.river-row .val { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
.river-row .caption { margin-top: 2px; }
@media (max-width: 768px) {
  .river-row { grid-template-columns: 1fr; }
  .river-row .val { text-align: left; white-space: normal; }
}

/* ---- ledger row drill-down (M21 #250) ----
   Lives here rather than in _base.html.j2 because only a market page renders
   it: the headline ledger has no pinned leg to overlay and no drill-down, and
   a copy of these rules in the shared <head> would invite one. Inline SVG in
   the block's own palette — Plotly is loaded for the headline's figures and is
   not worth shipping to eight market pages for a sparkline. */
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
/* Every affordance below is gated on `.drill-ready`, which the script adds. A
   chevron that opens nothing is worse than no chevron: with script off the
   ledger simply loses the drill-down and keeps the rest, band included. */
.drill-row[hidden] { display: none; }
.drill-toggle { display: none; background: none; border: none; padding: 0 6px 0 0; margin: 0; cursor: pointer; color: var(--text-dim); font-size: 11px; line-height: 1; }
.ledger.drill-ready .drill-toggle { display: inline-block; }
.ledger.drill-ready .lrow.has-drill { cursor: pointer; }
.ledger.drill-ready .lrow.has-drill:hover td { background: rgba(45,106,79,0.05); }
.ledger .lrow.open td { background: rgba(45,106,79,0.07); }
.lrow.open .drill-toggle .chev { display: inline-block; transform: rotate(90deg); }
.drill-hint { color: var(--text-dim); }

/* The range band, rendered server-side with the rest of the row: "high in its
   own range" must not depend on script running. */
.range-band { margin-top: 4px; font-size: 11px; color: var(--text-muted); font-weight: 400; }
.range-band .rb-track { display: block; position: relative; height: 3px; margin: 0 0 3px auto; width: 78px; background: var(--rule); border-radius: 2px; }
.range-band .rb-tick { position: absolute; top: -2px; width: 2px; height: 7px; background: var(--green); transform: translateX(-1px); }
.range-band.no-range { color: var(--text-dim); }

.drill-row > td { background: #F4F6F3; padding: 14px 16px; }
.drill-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.drill-pane { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; min-width: 0; }
.drill-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); margin-bottom: 6px; }
.drill-note { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
.drill-flat { font-family: var(--mono); font-size: 13px; color: var(--text); }
.drill-flat .v { font-size: 18px; font-weight: 500; }
.drill-windows { display: flex; gap: 6px; margin-bottom: 10px; }
.drill-windows .dw { font-family: var(--mono); font-size: 11px; padding: 2px 9px; border: 1px solid var(--rule); border-radius: 3px; background: var(--card); color: var(--text-muted); cursor: pointer; }
.drill-windows .dw.on { background: var(--green); border-color: var(--green); color: #fff; }
.drill-svg { width: 100%; height: auto; display: block; }
.drill-svg .ax { stroke: var(--rule); stroke-width: 1; }
.drill-svg .lbl { font-family: var(--mono); font-size: 9px; fill: var(--text-dim); text-anchor: end; }
.drill-svg .lbl.dt { text-anchor: start; }
.drill-svg .lbl.dt.end { text-anchor: end; }
.drill-svg .ln { fill: none; stroke-width: 1.4; }
.drill-svg .ln.own { stroke: var(--green); }
.drill-svg .ln.ref { stroke: var(--text-dim); stroke-dasharray: 4 3; }
.drill-svg .ln.fx { stroke: var(--info); }
.drill-svg .pt { stroke: none; }
.drill-svg .pt.own { fill: var(--green); }
.drill-svg .pt.ref { fill: var(--text-dim); }
.drill-svg .pt.fx { fill: var(--info); }
@media (max-width: 768px) { .drill-panes { grid-template-columns: 1fr; } }
