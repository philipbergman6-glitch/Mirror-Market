{# Shared market-surface CSS — imported by the page, brief and stub templates
   so the three tiers cannot drift apart visually. Kept out of _base.html.j2
   because the headline and players pages never render a block. #}
/* ---- tier stamp ---- */
.tier-stamp { display: flex; align-items: baseline; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 12px; color: var(--text-muted); flex-wrap: wrap; }
.tier-pill { font-family: var(--display); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 3px; background: var(--green); color: #fff; }
.tier-pill.brief { background: #E4E8E4; color: var(--text-muted); }
.tier-pill.stub { background: transparent; border: 1px solid var(--rule); color: var(--text-dim); }
.tier-why { color: var(--text-dim); }
.venue { font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }

{# `.kind` moved to _base.html.j2 with M19 #223: the headline ledger renders it
   too, and a second copy here is the drift the one-<head>-owner rule prevents. #}

/* ---- blocks ---- */
.block { padding: 22px 0; border-bottom: 1px solid var(--rule); }
.block:last-of-type { border-bottom: none; }
.block-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
.block-no { font-family: var(--mono); font-size: 12px; color: var(--green); font-weight: 500; }
.block-head h2 { font-family: var(--display); font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: 0.05em; }
.block-head .why { margin-left: auto; font-size: 12px; color: var(--text-dim); }

/* An empty state is a labelled statement, never a blank. `absent` reads calm
   (no source exists, by structure); `empty` reads warm (a source exists and
   gave us nothing) — M1 constraint 2's distinction, made visible. */
.empty-state { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; font-size: 13px; color: var(--text-muted); }
.empty-state .es-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); display: block; margin-bottom: 3px; }
.empty-state.state-empty { border-left: 3px solid var(--warning); }
.empty-state.state-empty .es-label { color: var(--warning); }
