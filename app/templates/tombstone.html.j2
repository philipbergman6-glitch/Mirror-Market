{% extends "_base.html.j2" %}
{#
  Page tombstone — M8 #150's middle failure level.

  A page that fails to render is REPLACED by this inside the private candidate,
  never left as yesterday's file. The promotion contract rejects every
  tombstone before upload, leaving the last trustworthy public edition intact.
#}
{% block title %}Mirror Market — {{ page_name }} unavailable{% endblock %}

{% block page_css %}
.tomb { background: var(--card); border: 1px solid var(--rule); border-left: 3px solid var(--bearish); border-radius: 8px; padding: 20px; margin: 28px 0; max-width: 720px; }
.tomb h2 { font-family: var(--display); font-weight: 700; font-size: 16px; margin-bottom: 8px; }
.tomb .err { font-family: var(--mono); font-size: 12px; color: var(--bearish); background: var(--paper); border: 1px solid var(--rule); border-radius: 3px; padding: 10px 12px; margin-top: 12px; white-space: pre-wrap; overflow-x: auto; }
.tomb p { font-size: 13px; color: var(--text-muted); }
{% endblock %}

{% block mast_meta %}
    <div class="day">{{ day_line }}</div>
    <div>Generated {{ generated_at }}</div>
{% endblock %}

{% block content %}
<div class="tomb">
  <h2>{{ page_name }} could not be generated today.</h2>
  <p>
    This page is deliberately blank rather than showing yesterday's numbers. Every other page in
    the site was built from today's run and is current; use the nav above.
  </p>
  <div class="err">{{ error }}</div>
</div>

<div class="footer">
  <a href="{{ root }}index.html">&larr; Daily read</a>
</div>
{% endblock %}
