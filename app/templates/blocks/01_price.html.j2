{# 01 Price — the decision number, dual-quoted USD/MT over the home currency
   (M3 #145). The quote kind is stamped by _block.html.j2's header, so a board
   settlement, a physical assessment and an administered minimum can never read
   as the same animal. #}
{% import 'blocks/_macros.html.j2' as f %}
{% set d = block.data %}
<div class="grid grid-{{ [d.legs|length, 3]|min }}">
  {% for leg in d.legs %}
  <div class="mc">
    <div class="mc-label">{{ leg.key }}{% if leg.is_headline %} · headline{% endif %}</div>
    {% if leg.label %}<div class="mc-delta muted">{{ leg.label }}</div>{% endif %}
    {#- B30 #504: a venue printing several shipment windows a session has
        published several prices; this card is one of them, and says which —
        by loading month first, the comparison key (B39 #540). -#}
    {% if leg.window %}<div class="mc-delta muted">{{ leg.loading }}{% if leg.windows_printed > 1 %} · nearest of {{ leg.windows_printed }} printed{% endif %}</div>{% endif %}
    <div class="mc-val">{{ f.usd(leg.usd_mt) }}<small class="muted"> /MT</small></div>
    {# A1 #298: a USD figure struck at a prior day's close says which day, and
       one withheld for want of a rate inside the cap says why — the home print
       below still renders either way. #}
    {%- if leg.fx_label %}<div class="caption">struck at {{ leg.fx_label }}</div>
    {%- elif leg.fx_reason %}<div class="caption">USD/MT withheld — {{ leg.fx_reason }}</div>{% endif %}
    <div class="mc-delta">
      {{ f.pct(leg.chg_1_pct) }} <span class="muted">session</span>
      {%- if leg.chg_21_pct is not none %} · {{ f.pct(leg.chg_21_pct) }} <span class="muted">21 obs</span>{% endif %}
    </div>
    {#- B30 #504: a move withheld across a window roll names the roll. -#}
    {%- for note in leg.move_notes %}<div class="caption">{{ note }}</div>{% endfor %}
    {# #230: the venue's own print, in the venue's own unit, and only where it
       is a second view of the number above. A `usd_per_mt` venue (Argentina's
       FOB, the EC workbook) already published the headline — re-labelling it
       with the home currency asserts a figure nobody observed. #}
    {%- set home = leg.has_home_quote and leg.home_value is not none %}
    {%- if home or leg.quotes > 1 %}
    <div class="mc-delta muted">{% if home %}{{ f.num(leg.home_value, 2) }} {{ leg.home_unit }}{% endif %}{% if home and leg.quotes > 1 %} · {% endif %}{% if leg.quotes > 1 %}mean of {{ leg.quotes }} quotes{% endif %}</div>
    {%- endif %}
    {{ f.asof(leg.as_of, leg.age_days) }}
  </div>
  {% endfor %}
</div>
{#- B30 #504: every window the venue printed on each leg's session, one click
    away — the card above is the nearest, never a mean across these. -#}
{%- set windowed = d.legs|selectattr('windows_printed')|selectattr('windows_printed', 'gt', 1)|list %}
{% if windowed %}
<details class="window-rows">
  <summary class="caption">Every shipment window printed{% if windowed|length == 1 %} on {{ windowed[0].as_of }}{% endif %}</summary>
  <div class="table-scroll">
  <table class="dtable">
    <thead><tr><th>Leg</th><th>Window</th><th class="num">USD/MT</th>{% if windowed[0].has_home_quote %}<th class="num">Home print</th>{% endif %}<th>Session</th></tr></thead>
    <tbody>
    {% for leg in windowed %}{% for w in leg.window_rows %}
      <tr><td>{{ leg.key }}</td><td>{{ w.window }}{% if w.is_chosen %} <span class="muted">· shown above</span>{% endif %}{% if w.quotes > 1 %} <span class="muted">· mean of {{ w.quotes }} quotes</span>{% endif %}</td><td class="num">{{ f.usd(w.usd_mt) }}</td>{% if windowed[0].has_home_quote %}<td class="num">{{ f.num(w.home_value, 2) }} <span class="muted">{{ leg.home_unit }}</span></td>{% endif %}<td>{{ leg.as_of }}</td></tr>
    {% endfor %}{% endfor %}
    </tbody>
  </table>
  </div>
</details>
{% endif %}
{% if d.signals %}
{# M2 #144: signals ride inside block 01 as severity chips rather than growing
   a tenth block. Price-only detectors — a generic source carries no volume
   column, and a signal we cannot compute is absent, not invented. #}
{% for sig in d.signals %}
<div class="sig"><span class="badge badge-{{ sig.severity }}">{{ sig.severity }}</span><span>{{ sig.message }}</span></div>
{% endfor %}
{% endif %}
{#- #513: a windowed series' chips read one window only, or say why there are none. -#}
{% if d.signals_note %}<div class="caption">{{ d.signals_note }}</div>{% endif %}
<div class="caption">{{ d.venue }} · {{ d.cadence }} · {{ d.no_timestamp_note }}</div>
