{# 01 Price — the decision number, dual-quoted USD/MT over the home currency
   (M3 #145). The quote kind is stamped by _block.html.j2's header, so a board
   settlement, a physical assessment and an administered minimum can never read
   as the same animal. #}
{% import 'blocks/_macros.html.j2' as f %}
{% set d = block.data %}
<div class="grid grid-{{ [d.legs|length, 3]|min }}">
  {% for leg in d.legs %}
  <div class="mc">
    <div class="mc-label">{{ leg.key }}{% if leg.is_headline %} · headline{% endif %}</div>
    <div class="mc-val">{{ f.usd(leg.usd_mt) }}<small class="muted"> /MT</small></div>
    <div class="mc-delta">
      {{ f.pct(leg.chg_1_pct) }} <span class="muted">session</span>
      {%- if leg.chg_21_pct is not none %} · {{ f.pct(leg.chg_21_pct) }} <span class="muted">21 obs</span>{% endif %}
    </div>
    {# The venue's own print, in the venue's own unit — and only where that is a
       second observation. A leg already published in USD/MT has one number, so
       restating it under the home currency would invent a quote (#230). #}
    <div class="mc-delta muted">
      {%- if leg.has_home_quote %}{{ f.num(leg.home_value, 2) }} {{ leg.home_unit }}{% if leg.quotes > 1 %} · {% endif %}{% endif -%}
      {%- if leg.quotes > 1 %}mean of {{ leg.quotes }} quotes{% endif -%}
    </div>
    {{ f.asof(leg.as_of, leg.age_days) }}
  </div>
  {% endfor %}
</div>
{% if d.signals %}
{# M2 #144: signals ride inside block 01 as severity chips rather than growing
   a tenth block. Price-only detectors — a generic source carries no volume
   column, and a signal we cannot compute is absent, not invented. #}
{% for sig in d.signals %}
<div class="sig"><span class="badge badge-{{ sig.severity }}">{{ sig.severity }}</span><span>{{ sig.message }}</span></div>
{% endfor %}
{% endif %}
<div class="caption">{{ d.venue }} · {{ d.cadence }} · {{ d.no_timestamp_note }}</div>
