{# 03 Crush margin. One engine, every market (M7 #149) — only the yields, the
   FX and the kind label vary, and the kind is stamped in the block header
   because a board margin, an administered one and a physical one are not the
   same claim.

   A second distinction rides beside it: `contract_basis`. A margin struck on
   named delivery months (ZSU26/ZMU26/ZLU26) states which contracts it is, and
   one struck on continuous main-contract series cannot — the underlying
   changes on the provider's own schedule and is not published. Those are
   different claims and the block renders them differently. #}
{% import 'blocks/_macros.html.j2' as f %}
{% set d = block.data %}
<div class="grid grid-4">
  <div class="mc">
    <div class="mc-label">Margin</div>
    <div class="mc-val {{ 'up' if d.profitable else 'down' }}">{{ f.signed(d.margin_usd_mt) }}<small class="muted"> /MT</small></div>
    {# A home-currency margin only exists where the legs share one per-MT
       currency; a board quoted in cents/bu, cents/lb and $/short ton has no
       such number, and printing one would invent a unit. #}
    {% if d.margin_home is not none %}<div class="mc-delta muted">{{ d.home_currency }} {{ f.num(d.margin_home, 0) }}/MT</div>{% endif %}
    {% if d.period_label %}<div class="mc-delta muted">{{ d.period_label }}</div>{% endif %}
    {{ f.asof(d.as_of, d.age_days) }}
    {#- A1 #298: the three legs share one session; the rate may be a prior close. -#}
    {% if d.fx_label %}<div class="caption">legs struck at {{ d.fx_label }}</div>{% endif %}
  </div>
  {% for name in ['bean', 'oil', 'meal'] %}
  <div class="mc">
    <div class="mc-label">{{ name }} — {{ d.legs[name].key }}</div>
    <div class="mc-val">{{ f.usd(d.legs[name].usd_mt) }}</div>
    <div class="mc-delta muted">USD/MT{% if name != 'bean' %} · yield {{ '%.3f'|format(d.yields[name]) }} MT/MT{% endif %}</div>
    {% if d.legs_named %}
    <div class="mc-delta muted">{{ d.legs[name].contract_month }} · {{ d.legs[name].price_label }}{% if not d.legs[name].settlement_proven %} · settlement not proven{% endif %}</div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% if d.legs_named %}
<div class="caption">
  {{ d.convention }}
  Legs are named contracts, all observed {{ d.as_of }} — {{ d.provider_display }}.
  {% if d.hedgeable %}Three listed months an order can be entered against; this is a paper margin, not advice to place one.{% endif %}
</div>
{% elif d.contract_note %}
<div class="alert alert-warn">{{ d.contract_note }}</div>
{% endif %}
{% if d.provisional %}
<div class="alert alert-warn">{{ d.provisional_note }}</div>
{% endif %}
{# The cash leg (#352): physical oil and meal beside the board margin, as a
   premium over the board — never a margin. Its own envelope, so a withheld
   cash leg says why without touching the board crush above. The board and
   premium cells exist only on the session AMS's own arithmetic proves it
   struck against (invariant 8); otherwise they are blank and the caption
   says why, while the ask itself still renders. #}
{% set cash = d.cash %}
{% if cash %}
<div class="cash-leg">
  <div class="mc-label">{{ cash.data.label }} <span class="kind">{{ cash.data.kind_label if cash.state == 'ok' else 'withheld' }}</span></div>
  {% if cash.state != 'ok' %}
  <div class="caption">Not shown: {{ cash.reason }}.</div>
  {% else %}
  {% set c = cash.data %}
  <div class="table-scroll">
  <table class="dtable">
    <thead>
      <tr>
        <th>Product</th>
        <th>Location</th>
        <th>Terms</th>
        <th class="num">Ask avg</th>
        <th class="num">Ask range</th>
        <th class="num">Board</th>
        <th class="num">Premium over board</th>
      </tr>
    </thead>
    <tbody>
      {% for r in c.rows %}
      <tr>
        <td>{{ r.product }}</td>
        <td>{{ r.location }}</td>
        <td>{{ r.terms }}</td>
        <td class="num">{{ f.usd(r.cash_avg) }}</td>
        <td class="num">{{ f.usd(r.cash_low) }} – {{ f.usd(r.cash_high) }}</td>
        <td class="num">{% for b in r.board %}{% if not loop.first %} · {% endif %}{{ b.contract }} {{ f.usd(b.usd_mt) }}{% else %}<span class="muted">—</span>{% endfor %}</td>
        <td class="num">{% if r.has_basis %}{{ f.signed(r.premium_low) }} to {{ f.signed(r.premium_high) }}{% else %}<span class="muted">—</span>{% endif %}{% if r.premium_note %}<div class="caption">{{ r.premium_note }}</div>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="caption">
    USD/MT. Week {{ c.week_start }} – {{ c.week_end }}, published {{ c.published_at }} — {{ c.source }}.
    A range of processor <em>asks</em> a market reporter collected over the week: not a trade, not a settlement, and not firm to us.
    {% if c.strike_session %}Board legs are CBOT closes of {{ c.strike_session }}, the session AMS struck its basis against ({{ c.strike_note }}); the premium is ask less board on that one session.
    {% else %}Board and premium withheld: {{ c.strike_note }}.{% endif %}
    This is the processor's cash premium, not a crush margin — no interior processor bean bid is ingested, and the Gulf bean bid is a different location.
  </div>
  {{ f.asof(c.week_end, c.age_days) }}
  {% endif %}
</div>
{% endif %}
