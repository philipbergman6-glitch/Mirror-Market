{# 06 Weather — this market's own growing regions, from the registry.
   Each card carries its ROLE (why this pin is on this page) and, when the
   crop is not in the ground, an out-of-season tag — M14 #207 keeps the
   reading and tags it rather than hiding or collapsing the card.
   Below the regions, the river that prices this market's freight where it
   has one (M25 #272 / M26 #273): river water is tradeable weather, which is
   why it renders here rather than as a tenth block — the nine block ids are
   the contract on every page. #}
{% import 'blocks/_macros.html.j2' as f %}
{% set d = block.data %}
{% if d.regions %}
<div class="grid grid-{{ [d.regions|length, 3]|min }}">
  {% for r in d.regions %}
  <div class="mc">
    <div class="mc-label">{{ r.region }}{% if r.season_note %} <span class="kind">off-season</span>{% endif %}</div>
    <div class="mc-val">{{ f.num(r.temp_max, 0) }}<small class="muted">°C max</small></div>
    <div class="mc-delta muted">{{ f.num(r.precip_mm, 1) }} mm · 7d {{ f.num(r.precip_7d_mm, 0) }} mm</div>
    <div class="caption" style="margin-bottom:2px;">{{ r.role }}{% if r.season_note %} · {{ r.season_note }}{% endif %}</div>
    {{ f.asof(r.as_of, r.age_days) }}
  </div>
  {% endfor %}
</div>
{% for a in d.alerts %}
<div class="alert alert-warn">{{ a.region }}: {{ a.text }}</div>
{% else %}
<div class="alert alert-ok">No threshold breach in {{ d.regions|length }} region{{ 's' if d.regions|length != 1 }}</div>
{% endfor %}
{# A rule the stored history cannot answer is named, never read as clear (#355). #}
{% for w in d.withheld %}
<div class="caption">{{ w.label }} not assessed ({{ w.regions|join(', ') }}): {{ w.reason }}</div>
{% endfor %}
{% endif %}
{% if d.rivers %}
<div class="river">
  <div class="river-head">River — the freight leg</div>
  {% for r in d.rivers %}
  <div class="river-row">
    <div class="lbl">
      {{ r.gauge }}
      {%- if r.note %}<div class="caption">{{ r.note }}</div>{% endif %}
      {%- if r.state == 'ok' %}<div class="caption">{{ r.attribution }}</div>{% endif %}
    </div>
    <div class="val">
      {%- if r.state == 'ok' -%}
      {{ f.num(r.stage, 2) }} {{ r.unit }}
      {%- if r.change_7d is not none %} · 7d {{ f.signed(r.change_7d, 2, ' ' ~ r.unit) }}{% endif %}
      {%- if r.forecast_stage is not none %}<div class="caption">forecast {{ f.num(r.forecast_stage, 2) }} {{ r.unit }} by {{ r.forecast_date }}</div>{% endif %}
      {{ f.asof(r.as_of, r.age_days) }}
      {%- else -%}
      <span class="muted">no reading</span>
      {%- endif -%}
    </div>
  </div>
  {% endfor %}
  {# A gauge with no declared low-water threshold raises no flag — St. Louis
     is carried as the barge-rate reference and no threshold for it is
     sourced. Inventing one to fill the line is what invariant 2 forbids. #}
  {% for r in d.rivers if r.state == 'ok' and r.low_water_breach %}
  <div class="alert alert-warn">{{ r.gauge }}: low water — {{ f.num(r.stage, 2) }} {{ r.unit }} at or below {{ f.num(r.low_water, 2) }} {{ r.unit }} ({{ r.low_water_basis }})</div>
  {% endfor %}
  {% for r in d.rivers if r.state == 'ok' and r.low_water_outlook_breach %}
  <div class="alert alert-info">{{ r.gauge }}: forecast to reach {{ f.num(r.forecast_stage, 2) }} {{ r.unit }} by {{ r.forecast_date }}, at or below {{ f.num(r.low_water, 2) }} {{ r.unit }} ({{ r.low_water_basis }})</div>
  {% endfor %}
  {% for r in d.rivers if r.state != 'ok' %}
  <div class="empty-state state-empty"><span class="es-label">empty</span>{{ r.reason }}</div>
  {% endfor %}
</div>
{% endif %}
{# S2 #374 §8.3 — "Storms — the port leg": the ports of every leg on this
   page's ledger, graded by analysis/hazards.py (the same rule set the briefing
   prints). Reuses the river section's rows — no tenth block, no new component.
   `not covered` is never rendered as `no storm`; the explicit green line names
   only the ports that were actually read clear. #}
{% if d.storms %}
<div class="river">
  <div class="river-head">Storms — the port leg · NHC + JTWC · checked {{ d.storms.checked_label }}</div>
  {% for p in d.storms.ports %}
  <div class="river-row">
    <div class="lbl">{{ p.short }}
      {%- if p.port_rain %}<div class="caption">port rain {{ p.port_rain.tp15_mm }} mm over 15 days · {{ p.port_rain.wet_days }} days ≥ 5 mm (loading delays) · {{ p.port_rain.stamp }}</div>{% endif %}
    </div>
    <div class="val">
      {%- if p.chip -%}
      <a class="hz-chip {{ p.chip_class }}" href="#block-weather" title="{{ p.reason or p.short }}">{{ p.chip }}</a>
      {%- elif p.state == 'clear' -%}
      <span class="muted">no storm ≤ 120 h</span>
      {%- elif p.state == 'not_covered' -%}
      <span class="muted">not covered</span>
      {%- elif p.state == 'stale' -%}
      <span class="muted">stale</span>
      {%- else -%}
      <span class="muted">no reading</span>
      {%- endif -%}
    </div>
  </div>
  {% endfor %}
  {% for line in d.storms.flagged %}
  <div class="{{ line.css_class }}">{{ line.text }}</div>
  {% endfor %}
  {% for line in d.storms.watches %}
  <div class="{{ line.css_class }}">{{ line.text }}</div>
  {% endfor %}
  {% for f in d.storms.failures %}
  <div class="empty-state state-empty"><span class="es-label">{{ f.label }}</span>{{ f.short }}: {{ f.reason }}</div>
  {% endfor %}
  {% if d.storms.clear_line %}
  <div class="alert alert-ok">{{ d.storms.clear_line }}</div>
  {% endif %}
  {% for n in d.storms.not_covered %}
  <div class="caption">{{ n.short }}: {{ n.reason }} — absence of a flag is not a clear reading</div>
  {% endfor %}
  {% if d.storms.not_exposed %}
  <div class="caption">Not exposed, so not assessed: {% for n in d.storms.not_exposed %}{{ n.short }} ({{ n.reason }}){% if not loop.last %}; {% endif %}{% endfor %}</div>
  {% endif %}
  <div class="caption">{{ d.storms.method }}</div>
</div>
{% endif %}
