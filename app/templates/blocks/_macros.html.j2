{#
  Number formatting for the block partials (M18 #214).

  Jinja rather than Python: a builder that formats has decided a presentation
  question inside the data layer, which is how "$1,234.5" ended up unparseable
  in the f-string builders this ticket replaces.
#}
{% macro usd(value, places=1) %}{% if value is none %}<span class="muted">n/a</span>{% else %}${{ '{:,.{}f}'.format(value, places) }}{% endif %}{% endmacro %}

{#- Sign and colour follow the number as *shown*: a move that rounds to zero
    reads a neutral "0.0", never a red "-0.0" — the colour would claim a
    direction the printed digits deny. -#}
{% macro signed(value, places=1, unit='') %}{% if value is none %}<span class="muted">n/a</span>{% elif value|round(places) == 0 %}<span class="muted">{{ '{:,.{}f}'.format(0, places) }}{{ unit }}</span>{% else %}<span class="{{ 'up' if value > 0 else 'down' }}">{{ '{:+,.{}f}'.format(value, places) }}{{ unit }}</span>{% endif %}{% endmacro %}

{% macro pct(value, places=1) %}{% if value is none %}<span class="muted">—</span>{% elif value|round(places) == 0 %}<span class="muted">{{ '{:.{}f}'.format(0, places) }}%</span>{% else %}<span class="{{ 'up' if value > 0 else 'down' }}">{{ '{:+.{}f}'.format(value, places) }}%</span>{% endif %}{% endmacro %}

{% macro num(value, places=0) %}{% if value is none %}<span class="muted">n/a</span>{% else %}{{ '{:,.{}f}'.format(value, places) }}{% endif %}{% endmacro %}

{#- A print's own date, plus how stale it is. M4 #146: dates only, never a
    time of day, because the stack stores none. -#}
{#- #370: "thin day · 18 lots (typical weekday ~131)" — the neutral badge
    (DESIGN.md signal-row token) carries the first words, the counts follow as
    caption text. Neutral, never warning: the day was complete, only small. -#}
{% macro thin_day(text) %}{% if text %}{% set head, tail = text.split(' · ', 1) %}<div class="caption thin-day"><span class="badge badge-info">{{ head }}</span> · {{ tail }}</div>{% endif %}{% endmacro %}
{% macro asof(when, age_days=None) %}<div class="caption">as of {{ when }}{% if age_days is not none and age_days > 1 %} · {{ age_days }}d ago{% endif %}</div>{% endmacro %}
