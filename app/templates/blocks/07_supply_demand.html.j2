{# 07 Supply & demand — annual, and stamped as annual. M10 #151: a non-daily
   series rendered beside daily ones without its cadence reads as an outage. #}
{% import 'blocks/_macros.html.j2' as f %}
{% set d = block.data %}
{% if d.lines %}
<div class="grid grid-4">
  {% for line in d.lines %}
  <div class="mc">
    <div class="mc-label">{{ line.attribute }} ({{ d.marketing_year }})</div>
    <div class="mc-val">{{ f.num(line.value) }}</div>
    <div class="mc-delta">{{ f.pct(line.yoy_pct) }} <span class="muted">YoY · {{ line.unit }}</span></div>
  </div>
  {% endfor %}
</div>
<div class="caption">{{ d.country }} · {{ d.cadence_note }}</div>
{% endif %}
{% if d.flows %}
{# The physical-flow leg, where the registry names one. South Africa is the
   case it exists for: the price leg is licence-capped, the tonnage is not. #}
<div class="subhdr">{{ d.flows.label }} — {{ d.flows.cadence }}</div>
<div class="grid grid-{{ [d.flows.lines|length, 3]|min }}">
  {% for line in d.flows.lines %}
  <div class="mc">
    <div class="mc-label">{{ line.key }}</div>
    <div class="mc-val">{{ f.num(line.value) }}</div>
    <div class="mc-delta muted">{{ d.flows.unit }}</div>
    {{ f.asof(line.as_of, line.age_days) }}
  </div>
  {% endfor %}
</div>
{% if d.flows.attribution %}<div class="caption">{{ d.flows.attribution }}</div>{% endif %}
{% endif %}
{% if d.exports %}
{# Customs export flows (Layer 29, #351) — monthly and stamped monthly, the
   newest month preliminary by the publisher's own rule. #}
{% set x = d.exports %}
{% if x.state == 'ok' %}
{% set xd = x.data %}
<div class="subhdr">{{ xd.label }} — {{ xd.month_label }} · {{ xd.cadence }} · <span class="muted">preliminary</span></div>
<div class="table-scroll">
<table class="dtable">
  <thead>
    <tr>
      <th>Product</th><th class="num">Total, million t</th><th class="num">To {{ xd.focus_destination }}, million t</th>
      <th class="num">Share</th><th class="num">Rest of world, million t</th>
      <th class="num">Total vs {{ xd.year_ago_label }}</th><th class="num">{{ xd.focus_destination }} vs {{ xd.year_ago_label }}</th>
      {% if xd.unit_value_trend is defined %}<th class="num">Unit value, USD/MT</th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for r in xd.rows %}
    <tr>
      <td>{{ r.product }}</td>
      <td class="num">{{ f.num(r.million_t, 2) }}</td>
      <td class="num">{{ f.num(r.focus_million_t, 2) }}</td>
      <td class="num">{% if r.focus_share_pct is none %}<span class="muted">—</span>{% else %}{{ '{:.0f}'.format(r.focus_share_pct) }}%{% endif %}</td>
      <td class="num">{{ f.num(r.rest_million_t, 2) }}</td>
      <td class="num">{{ f.pct(r.yoy_pct) }}</td>
      <td class="num">{{ f.pct(r.focus_yoy_pct) }}</td>
      {% if xd.unit_value_trend is defined %}<td class="num">{{ f.usd(r.unit_value_usd_mt) }}</td>{% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{{ f.asof(xd.as_of, xd.age_days) }}
<div class="caption">{{ xd.unreleased_note }}. {{ xd.revision_note }}</div>
{% if xd.unit_value_caveat is defined %}<div class="caption">{{ xd.unit_value_caveat }}</div>{% endif %}
{% if xd.withheld_note is defined %}<div class="caption muted">{{ xd.withheld_note }}</div>{% endif %}
<div class="caption">{{ xd.attribution }}</div>
{% else %}
<div class="subhdr">Customs exports — monthly</div>
<div class="caption muted">Withheld: {{ x.reason }}</div>
{% endif %}
{% endif %}
