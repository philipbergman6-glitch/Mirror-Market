{% extends "_base.html.j2" %}
{#
  The headline page (M2 #144). Everything shared — <head>, the palette, the
  masthead and the market nav — lives in _base.html.j2; this file owns only
  what is specific to the headline.
#}
{% block title %}Mirror Market — Daily Soy Complex Read{% endblock %}

{% block head_extra %}
<script src="https://cdn.plot.ly/plotly-2.35.0.min.js"></script>
{% endblock %}

{% block page_css %}
/* ---- sections ---- */
section { padding: 26px 0; border-bottom: 1px solid var(--rule); }
section:last-of-type { border-bottom: none; }
.sec-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; cursor: pointer; user-select: none; flex-wrap: wrap; }
.sec-no { font-family: var(--mono); font-size: 12px; color: var(--green); font-weight: 500; }
.sec-head h2 { font-family: var(--display); font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: 0.05em; }
.sec-head .why { color: var(--text-dim); font-size: 12px; margin-left: auto; }
.sec-head .chev { font-size: 11px; color: var(--text-dim); display: inline-block; transition: transform 0.15s; }
section.collapsed .sec-body { display: none; }
section.collapsed .sec-head { margin-bottom: 0; }
section.collapsed .sec-head .chev { transform: rotate(-90deg); }

/* ---- leg cards / metric cards ---- */
.legs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
.leg { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 16px 18px; }
.leg .name { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
.leg .px { font-family: var(--display); font-weight: 700; font-size: 32px; letter-spacing: -0.02em; margin: 4px 0 2px; }
.leg .px small { font-size: 13px; font-weight: 500; color: var(--text-dim); }
.leg .chg { font-size: 13px; font-weight: 500; }
.leg .sub { font-size: 12px; color: var(--text-muted); margin-top: 8px; display: flex; gap: 14px; flex-wrap: wrap; }
/* ---- headline-only: collapsible sub-categories ---- */
.subhdr.togglable { cursor: pointer; user-select: none; }
.subhdr.togglable::after { content: "\25BE"; font-size: 10px; color: var(--text-dim); margin-left: 8px; }
.subhdr.togglable.closed::after { content: "\25B8"; }
.subhdr.togglable.closed + .sub-body { display: none; }

/* ---- tabs ---- */
.tabs { display: flex; gap: 0; border-bottom: 1px solid var(--rule); margin-bottom: 18px; }
.tab { padding: 8px 16px; font-size: 13px; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent; transition: color 0.1s; }
.tab:hover { color: var(--ink); }
.tab.active { color: var(--ink); font-weight: 600; border-bottom-color: var(--green); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }


/* ---- briefing ---- */
.briefing { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 20px; font-family: var(--mono); font-size: 12px; line-height: 1.7; white-space: pre-wrap; overflow-x: auto; }

/* ---- collapsible ---- */
details { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; margin-bottom: 16px; }
details summary { padding: 12px 16px; font-size: 13px; font-weight: 600; cursor: pointer; list-style: none; }
details summary::before { content: "\25B6"; font-size: 10px; margin-right: 8px; color: var(--text-dim); display: inline-block; transition: transform 0.15s; }
details[open] summary::before { transform: rotate(90deg); }
details .det-content { padding: 0 16px 16px; max-width: 100%; overflow-x: auto; }
@media (max-width: 768px) {
  .sec-head .why { flex-basis: 100%; margin-left: 0; overflow-wrap: anywhere; }
}

/* ---- misc ---- */
.dl { display: inline-flex; align-items: center; gap: 6px; color: var(--green); text-decoration: none; font-size: 13px; font-weight: 500; margin-right: 16px; }
.dl:hover { text-decoration: underline; }

@media (max-width: 768px) {
  .legs { grid-template-columns: 1fr; }
}
{% endblock %}

{% block mast_meta %}
    <div class="day">{{ masthead.day_line }}</div>
    <div>Generated {{ generated_at }} · {{ masthead.on_schedule_count }}/{{ masthead.total_layers }} layers on schedule{% if masthead.critical_count %} · <span class="mast-critical">{{ masthead.critical_count }} data critical{{ "s" if masthead.critical_count != 1 }}</span>{% endif %}</div>
    {# Generation time is not observation time, and on this site they are
       routinely a day apart: the settlement guard publishes the previous
       session's close on any build landing before 14:30 Chicago. Stating
       only "Generated" lets that correct behaviour read as a fresher product
       than it is, so the oldest board/FX observation is stated beside it. #}
    {% if masthead.price_age %}<div>Board and FX priced from data <b>{{ masthead.price_age }}</b> old · <a href="manifest.json">latency detail</a></div>{% endif %}
    <div>Soy complex + competing crops · all prices USD/MT</div>
{% endblock %}

{% block prenav %}
{% if masthead.late_layers %}
<div class="stale-note"><b>Stale:</b>
  {%- for s in masthead.late_layers %} {{ s.name }} ({{ s.age }}){{ "," if not loop.last }}{% endfor %} — everything else current.
</div>
{% endif %}
{% endblock %}

{% block subnav %}
<nav class="index-nav">
  {% for s in sections %}
  <a href="#{{ s.id }}"><span class="no">{{ s.no }}</span>{{ s.name }}</a>
  {% endfor %}
</nav>
{% endblock %}

{% block content %}
{#- The five ported sections (M18 #214) arrive as {state, reason, data}. A
    render that omits one — a focused test, a partial context — treats it as an
    empty section with that stated, rather than raising on a missing key. -#}
{% set _missing = {'state': 'empty', 'reason': 'section was not built for this render', 'data': {}} %}
{% set relative_value = relative_value|default(_missing, true) %}
{% set risk_monitor = risk_monitor|default(_missing, true) %}
{% set forward_curves = forward_curves|default(_missing, true) %}
{% set seasonal = seasonal|default(_missing, true) %}
{% set emerging_markets = emerging_markets|default(_missing, true) %}
{% set ledger = ledger|default(_missing, true) %}
{% set crush_board = crush_board|default(_missing, true) %}
{# ================================================================ #}
{# 01 — THE COMPLEX OVERNIGHT                                       #}
{# ================================================================ #}
<section id="overnight">
  <div class="sec-head"><span class="sec-no">01</span><h2>The Complex Overnight</h2><span class="why">first look — where did we open</span></div>
  {% if command_center %}
  <div class="legs">
    {% for leg in command_center.legs %}
    <div class="leg" data-benchmark="{{ leg.name }}" data-as-of="{{ leg.as_of }}">
      <div class="name" style="color: {{ leg.color }}">{{ leg.name }}</div>
      <div class="px num">{{ leg.price }}<small> $/MT</small></div>
      <div class="chg num {{ leg.chg_class }}">{{ leg.daily_chg }} today</div>
      <div class="sub">
        <span>RSI <span class="num{% if leg.rsi_class %} {{ leg.rsi_class }}{% endif %}">{{ leg.rsi }}</span></span>
        <span class="{{ leg.trend_class }}">{{ leg.trend }}</span>
        <span>Vol {{ leg.volatility }}</span>
        {% if leg.as_of %}<span>as of {{ leg.as_of }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="grid grid-4">
    {% for m in command_center.key_metrics %}
    {# The alignment probe the promotion contract reads. Keyed off a declared
       field rather than the tile's display label, which a rename would break
       silently (M16 #208). #}
    <div class="mc"{% if m.derived is defined and m.derived %} data-derived="{{ m.derived }}" data-aligned="{{ 'true' if m.as_of else 'false' }}" data-as-of="{{ m.as_of }}"{% endif %}>
      <div class="mc-label">{{ m.label }}</div>
      <div class="mc-val num {{ m.val_class }}">{{ m.value }}</div>
      <div class="mc-delta {{ m.delta_class }}">{{ m.delta }}</div>
      {% if m.as_of %}<div class="caption">as of {{ m.as_of }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="alert alert-warn">No price data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 02 — WHAT FIRED                                                  #}
{# ================================================================ #}
<section id="signals">
  <div class="sec-head"><span class="sec-no">02</span><h2>What Fired</h2>
    <span class="why">signals by severity{% if command_center and command_center.signals %} — {{ command_center.signals|length }} active{% endif %}</span>
  </div>
  {% if command_center and command_center.signals %}
  {% for sig in command_center.signals %}
  <div class="sig">
    <span class="badge badge-{{ sig.severity }}">{{ sig.severity_label }}</span>
    <span class="sig-commodity">{{ sig.commodity }}</span>
    <span>{{ sig.message }}</span>
  </div>
  {% endfor %}
  {% else %}
  <div class="alert alert-ok">No active signals — quiet tape.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 03 — PROPAGATION                                                 #}
{# ================================================================ #}
<section id="propagation">
  <div class="sec-head"><span class="sec-no">03</span><h2>Propagation</h2><span class="why">who has repriced, and who has not printed</span></div>
  {% if ledger.state == 'ok' %}
  {% with s = ledger.data %}{% include 'sections/ledger.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ ledger.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 04 — CRUSH BOARD                                                 #}
{# ================================================================ #}
<section id="crush-board">
  <div class="sec-head"><span class="sec-no">04</span><h2>Crush Board</h2><span class="why">is processing paying, and where</span></div>
  {% if crush_board.state == 'ok' %}
  {% with s = crush_board.data %}{% include 'sections/crush_board.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ crush_board.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 05 — RELATIVE VALUE                                              #}
{# ================================================================ #}
<section id="relative-value">
  <div class="sec-head"><span class="sec-no">05</span><h2>Relative Value</h2><span class="why">where is Brazil · oil vs meal · the competing oils</span></div>
  {% if relative_value.state == 'ok' %}
  {% with s = relative_value.data %}{% include 'sections/relative_value.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ relative_value.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 05 — SUPPLY & DEMAND                                             #}
{# ================================================================ #}
<section id="supply-demand">
  <div class="sec-head"><span class="sec-no">06</span><h2>Supply &amp; Demand</h2><span class="why">WASDE · CONAB · exports · emerging markets</span></div>
  {% if supply or demand or emerging_markets.state == 'ok' %}
  <div class="tabs" data-tabgroup="sd">
    <div class="tab active" data-tab="sd-1">Soy Complex</div>
    <div class="tab" data-tab="sd-2">Competing Crops</div>
    <div class="tab" data-tab="sd-3">Emerging Markets</div>
  </div>

  <div class="tab-panel active" data-tabpanel="sd-1">
    {% if supply %}
    {% if supply.wasde_html %}
    <div class="subhdr">WASDE Monthly Estimates</div>
    {{ supply.wasde_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.stocks_to_use_html %}
    <div class="subhdr">Stocks-to-Use (US balance sheet)</div>
    {{ supply.stocks_to_use_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.conab_html %}
    <div class="subhdr">CONAB vs USDA (Brazil)</div>
    {{ supply.conab_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.crop_progress_html %}
    <div class="subhdr">Crop Progress &amp; Condition</div>
    {{ supply.crop_progress_html | safe }}
    <hr class="divider">
    {% endif %}
    {% endif %}
    {% if demand %}
    {% if demand.china_html %}
    <div class="subhdr">China Buying Pace</div>
    {{ demand.china_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if demand.export_sales_html %}
    <div class="subhdr">Export Sales</div>
    {{ demand.export_sales_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if demand.biofuel_html %}
    <div class="subhdr">Biofuel &amp; Energy</div>
    {{ demand.biofuel_html | safe }}
    {% endif %}
    {% endif %}
  </div>

  <div class="tab-panel" data-tabpanel="sd-2">
    {% if supply and supply.competing_html %}
    {{ supply.competing_html | safe }}
    {% else %}
    <div class="chart-empty">No competing crop data available</div>
    {% endif %}
  </div>

  <div class="tab-panel" data-tabpanel="sd-3">
    {% if emerging_markets.state == 'ok' %}
    {% with s = emerging_markets.data %}{% include 'sections/emerging_markets.html.j2' %}{% endwith %}
    {% else %}
    <div class="alert alert-warn">{{ emerging_markets.reason }}</div>
    {% endif %}
  </div>
  {% else %}
  <div class="alert alert-warn">No supply/demand data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 06 — RISK MONITOR                                                #}
{# ================================================================ #}
<section id="risk">
  <div class="sec-head"><span class="sec-no">07</span><h2>Risk Monitor</h2><span class="why">currencies · positioning · weather</span></div>
  {% if risk_monitor.state == 'ok' %}
  {% with s = risk_monitor.data %}{% include 'sections/risk_monitor.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ risk_monitor.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 07 — FORWARD CURVES                                              #}
{# ================================================================ #}
<section id="forward-curves">
  <div class="sec-head"><span class="sec-no">08</span><h2>Forward Curves</h2><span class="why">contango or backwardation — what the term structure says</span></div>
  {% if forward_curves.state == 'ok' %}
  {% with s = forward_curves.data %}{% include 'sections/forward_curves.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ forward_curves.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 08 — SEASONAL                                                    #}
{# ================================================================ #}
<section id="seasonal">
  <div class="sec-head"><span class="sec-no">09</span><h2>Seasonal</h2><span class="why">current price vs the historical norm for this month</span></div>
  {% if seasonal.state == 'ok' %}
  {% with s = seasonal.data %}{% include 'sections/seasonal.html.j2' %}{% endwith %}
  {% else %}
  <div class="alert alert-warn">{{ seasonal.reason }}</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 09 — TECHNICALS                                                  #}
{# ================================================================ #}
<section id="technicals">
  <div class="sec-head"><span class="sec-no">10</span><h2>Technicals</h2><span class="why">the deep charts — candles, RSI, MACD</span></div>
  {% if technicals %}
  <div class="alert alert-info" style="margin-bottom: 16px;">
    Charts use the yfinance front-month series. On contract roll days the underlying contract changes, which can introduce artificial price gaps; signals within ±3 trading days of a roll are demoted to <em>info</em> severity.
  </div>
  <div class="tabs" data-tabgroup="tech">
    {% for leg in technicals %}
    <div class="tab{% if loop.first %} active{% endif %}" data-tab="tech-{{ loop.index }}">{{ leg.name }}</div>
    {% endfor %}
  </div>
  {% for leg in technicals %}
  <div class="tab-panel{% if loop.first %} active{% endif %}" data-tabpanel="tech-{{ loop.index }}">
    <div class="chart-box">{{ leg.chart_html | safe }}</div>
    {% if leg.signals %}
    {% for sig in leg.signals %}
    <div class="sig">
      <span class="badge badge-{{ sig.severity }}">{{ sig.severity_label }}</span>
      <span>{{ sig.message }}</span>
    </div>
    {% endfor %}
    {% endif %}
    {% if leg.csv_uri %}
    <div style="margin-top: 12px;"><a class="dl" href="{{ leg.csv_uri }}" download="{{ leg.name }}.csv">&#8595; Download CSV</a></div>
    {% endif %}
  </div>
  {% endfor %}
  {% else %}
  <div class="alert alert-warn">No technical data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 10 — THE FULL BRIEFING                                           #}
{# ================================================================ #}
<section id="briefing">
  <div class="sec-head"><span class="sec-no">11</span><h2>The Full Briefing</h2><span class="why">the complete daily report, in text</span></div>
  {% if briefing_text %}
  <div class="briefing">{{ briefing_text }}</div>
  {% if briefing_uri %}
  <div style="margin-top: 16px;">
    <a class="dl" href="{{ briefing_uri }}" download="mirror_market_briefing.txt">&#8595; Download briefing as TXT</a>
  </div>
  {% endif %}
  {% if health_html %}
  <details style="margin-top: 16px;">
    <summary>Data Health Check</summary>
    <div class="det-content">{{ health_html | safe }}</div>
  </details>
  {% endif %}
  {% else %}
  <div class="alert alert-warn">No briefing data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 11 — ABOUT THE DATA                                              #}
{# ================================================================ #}
<section id="about">
  <div class="sec-head"><span class="sec-no">12</span><h2>About the Data</h2><span class="why">sources · methodology · units</span></div>

  <details>
    <summary>Data Sources ({{ production_layers|length }} Operational Layers)</summary>
    <div class="det-content">
    <table class="dtable">
      <thead>
        <tr><th>Layer</th><th>Source</th><th>Frequency</th><th>Coverage</th></tr>
      </thead>
      <tbody>
        {% for layer in production_layers %}
        <tr><td>{{ layer[1] }}</td><td>{{ layer[2] }}</td><td>{{ layer[3] }}</td><td>{{ layer[4] }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>

  {% if freshness_items %}
  <details>
    <summary>Layer Freshness ({{ masthead.on_schedule_count }}/{{ masthead.total_layers }} on schedule)</summary>
    <div class="det-content">
    <table class="dtable">
      {# Two different clocks, side by side and never merged.

         "Last Success" is RUN freshness: when this pipeline last completed.
         "Observed" is DATA freshness: what the newest number is dated. They
         diverge in exactly the case that matters — a run landing before the
         CBOT settlement succeeds, stamps a fresh last_success, and carries
         yesterday's close. One column alone reads "0h ago" for a day-old
         price. "Age" is the observation's staleness right now, which is the
         figure a reader is actually deciding on. #}
      <thead>
        <tr><th>Layer</th><th>Status</th><th>Keys</th><th>Observed</th><th>Fetched</th><th>Age</th><th>Last Success</th></tr>
      </thead>
      <tbody>
        {% for item in freshness_items %}
        <tr data-layer="{{ item.name }}"{% if item.observed %} data-observed-at="{{ item.observed }}"{% endif %}>
          <td>{{ item.name }}</td>
          <td><span class="{% if item.status == 'fresh' %}up{% elif item.status in ('old', 'degraded') %}down{% else %}muted{% endif %}">{{ item.status }}</span></td>
          {# Coverage is rendered only below full: a badge on every healthy
             layer every day is the badge-blindness #176 removed (#182). #}
          <td class="num">{% if item.coverage %}<span class="muted">{{ item.coverage }}</span>{% endif %}</td>
          <td class="num">{% if item.observed %}{{ item.observed }}{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
          <td class="num">{% if item.fetched %}{{ item.fetched }}{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
          <td class="num">{% if item.data_age %}{{ item.data_age }}{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
          <td class="num">{{ item.age }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}

  {% if public_trust %}
  <details>
    <summary>Public Trust Metadata</summary>
    <div class="det-content">
    <table class="dtable">
      <tbody>
        <tr><th>Edition ID</th><td class="num">{{ public_trust.edition_id|e }}</td></tr>
        <tr><th>Generated</th><td class="num">{{ public_trust.generated_at|e }}</td></tr>
      </tbody>
    </table>

    <div class="subhdr" style="font-size:13px; margin-top:16px;">Critical Freshness</div>
    <table class="dtable">
      <thead><tr><th>Dataset</th><th>Freshness</th></tr></thead>
      <tbody>
        {% for item in public_trust.critical_freshness %}
        <tr>
          <td class="num">{{ item.dataset_id|e }}</td>
          <td>{{ item.freshness|e }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="subhdr" style="font-size:13px; margin-top:16px;">Degraded Datasets</div>
    {% if public_trust.degraded_dataset_ids %}
    <table class="dtable">
      <tbody>
        {% for dataset_id in public_trust.degraded_dataset_ids %}
        <tr><td class="num">{{ dataset_id|e }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="alert alert-ok">No degraded public datasets.</div>
    {% endif %}

    <div class="subhdr" style="font-size:13px; margin-top:16px;">Critical Number Provenance</div>
    <table class="dtable">
      <thead>
        <tr><th>Label</th><th>Source</th><th>Dataset</th><th>As Of</th><th>Quality</th><th>Observation</th><th>Revision</th></tr>
      </thead>
      <tbody>
        {% for item in public_trust.critical_numbers %}
        <tr>
          <td>{{ item.label|e }}</td>
          <td>{{ item.source_id|e }}</td>
          <td>{{ item.dataset_key|e }}</td>
          <td class="num">{{ item.as_of_date|e }}</td>
          <td>{{ item.quality_state|e }}</td>
          <td class="num">{{ item.observation_id|e }}</td>
          <td class="num">{{ item.revision_id|e }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}

  <details>
    <summary>Analysis Methodology</summary>
    <div class="det-content">
    <table class="dtable">
      <thead><tr><th>Indicator</th><th>Parameters</th><th>What It Detects</th></tr></thead>
      <tbody>
        <tr><td>Simple Moving Average</td><td>20 / 50 / 200 day</td><td>Trend direction at three timeframes</td></tr>
        <tr><td>RSI</td><td>14-day, Wilder smoothing</td><td>Overbought (&gt;70) / Oversold (&lt;30)</td></tr>
        <tr><td>MACD</td><td>12 / 26 / 9</td><td>Momentum shifts and trend strength</td></tr>
        <tr><td>Bollinger Bands</td><td>20-day, 2 std</td><td>Volatility compression and breakouts</td></tr>
        <tr><td>Crush Spread</td><td>Oil*11 + Meal*2.2 - Beans</td><td>Processing margin profitability</td></tr>
        <tr><td>Forward Curve</td><td>Sequential months</td><td>Contango / backwardation structure</td></tr>
        <tr><td>Seasonal</td><td>Historical monthly avg</td><td>Current vs historical norms</td></tr>
      </tbody>
    </table>
    </div>
  </details>

  <div class="footer">
    All prices in <strong>USD per metric ton (USD/MT)</strong>; native exchange units are converted at the display layer.
    Mirror Market is a project by Philip Bergman. Data sourced from free public APIs. Not financial advice; all data delayed and provided as-is.
    <br><br>
    <a class="dl" href="https://github.com/philipbergman6-glitch/Mirror-Market" target="_blank">View source on GitHub</a>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script>
// Collapsible sections — click a numbered header to open/close
document.querySelectorAll('section').forEach(sec => {
  const head = sec.querySelector('.sec-head');
  if (!head) return;
  const chev = document.createElement('span');
  chev.className = 'chev';
  chev.textContent = '▾';
  head.appendChild(chev);
  const body = document.createElement('div');
  body.className = 'sec-body';
  while (head.nextSibling) body.appendChild(head.nextSibling);
  sec.appendChild(body);
  head.addEventListener('click', () => {
    sec.classList.toggle('collapsed');
    if (!sec.classList.contains('collapsed')) window.dispatchEvent(new Event('resize'));
  });
});

// Collapsible sub-categories — every .subhdr toggles the content that follows it
document.querySelectorAll('.sec-body .subhdr').forEach(h => {
  const wrap = document.createElement('div');
  wrap.className = 'sub-body';
  let n = h.nextSibling;
  while (n && !(n.nodeType === 1 && n.classList && n.classList.contains('subhdr'))) {
    const next = n.nextSibling;
    wrap.appendChild(n);
    n = next;
  }
  h.after(wrap);
  h.classList.add('togglable');
  h.addEventListener('click', () => {
    h.classList.toggle('closed');
    if (!h.classList.contains('closed')) window.dispatchEvent(new Event('resize'));
  });
});

// Index nav — jumping to a collapsed section reopens it
document.querySelectorAll('.index-nav a').forEach(a => {
  a.addEventListener('click', () => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target && target.classList.contains('collapsed')) {
      target.classList.remove('collapsed');
      window.dispatchEvent(new Event('resize'));
    }
  });
});

// Tab switching
document.querySelectorAll('.tabs').forEach(tabBar => {
  tabBar.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const group = tabBar.dataset.tabgroup;
      tabBar.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const panelId = tab.dataset.tab;
      document.querySelectorAll('[data-tabpanel^="' + group + '-"]').forEach(p => p.classList.remove('active'));
      document.querySelector('[data-tabpanel="' + panelId + '"]').classList.add('active');
      window.dispatchEvent(new Event('resize'));  // let Plotly reflow charts in newly shown panels
    });
  });
});
</script>
{% endblock %}
