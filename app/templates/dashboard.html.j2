<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mirror Market — Daily Soy Complex Read</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.plot.ly/plotly-2.35.0.min.js"></script>
<style>
:root {
  --paper: #FAFAF7;
  --card: #FFFFFF;
  --rule: #D8DCD8;
  --rule-heavy: #191C1A;
  --ink: #191C1A;
  --green: #2D6A4F;
  --green-light: #2D6A4F;
  --text: #191C1A;
  --text-muted: #5D6660;
  --text-dim: #9BA39E;
  --bullish: #1F7A3D;
  --bearish: #C23B2E;
  --warning: #A8730A;
  --info: #2F5D8F;
  --soybean: #8B6914;
  --soy-oil: #B05E10;
  --soy-meal: #8A5A2B;
  --font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --display: 'Archivo', sans-serif;
  --mono: 'IBM Plex Mono', 'SF Mono', monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { background: var(--paper); color: var(--ink); font-family: var(--font); font-size: 14px; line-height: 1.45; }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.up { color: var(--bullish); }
.down { color: var(--bearish); }
.muted { color: var(--text-muted); }

.page { max-width: 1180px; margin: 0 auto; padding: 32px 32px 64px; }

/* ---- masthead ---- */
.masthead { border-bottom: 3px solid var(--rule-heavy); padding-bottom: 18px; display: flex; align-items: flex-end; gap: 24px; }
.masthead h1 { font-family: var(--display); font-weight: 800; font-size: 42px; letter-spacing: -0.03em; line-height: 1; }
.masthead h1 em { font-style: normal; color: var(--green); }
.mast-meta { margin-left: auto; text-align: right; font-size: 12px; color: var(--text-muted); }
.mast-meta .day { font-family: var(--display); font-weight: 700; font-size: 14px; color: var(--ink); text-transform: uppercase; letter-spacing: 0.06em; }
.stale-note { font-size: 12px; color: var(--warning); border-bottom: 1px solid var(--rule); padding: 8px 0; }
.stale-note b { font-weight: 600; }

/* ---- index nav ---- */
.index-nav { position: sticky; top: 0; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--rule); display: flex; gap: 20px; padding: 10px 0; overflow-x: auto; white-space: nowrap; }
.index-nav a { text-decoration: none; color: var(--text-muted); font-size: 12px; transition: color 0.1s; }
.index-nav a:hover { color: var(--ink); }
.index-nav a .no { font-family: var(--mono); font-size: 11px; color: var(--green); margin-right: 4px; }

/* ---- sections ---- */
section { padding: 26px 0; border-bottom: 1px solid var(--rule); }
section:last-of-type { border-bottom: none; }
.sec-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; cursor: pointer; user-select: none; }
.sec-no { font-family: var(--mono); font-size: 12px; color: var(--green); font-weight: 500; }
.sec-head h2 { font-family: var(--display); font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: 0.05em; }
.sec-head .why { color: var(--text-dim); font-size: 12px; margin-left: auto; }
.sec-head .chev { font-size: 11px; color: var(--text-dim); display: inline-block; transition: transform 0.15s; }
section.collapsed .sec-body { display: none; }
section.collapsed .sec-head { margin-bottom: 0; }
section.collapsed .sec-head .chev { transform: rotate(-90deg); }

/* ---- leg cards / metric cards ---- */
.legs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
.leg { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 16px 18px; }
.leg .name { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
.leg .px { font-family: var(--display); font-weight: 700; font-size: 32px; letter-spacing: -0.02em; margin: 4px 0 2px; }
.leg .px small { font-size: 13px; font-weight: 500; color: var(--text-dim); }
.leg .chg { font-size: 13px; font-weight: 500; }
.leg .sub { font-size: 12px; color: var(--text-muted); margin-top: 8px; display: flex; gap: 14px; flex-wrap: wrap; }

.grid { display: grid; gap: 16px; margin-bottom: 16px; align-items: start; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.mc { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; }
.mc-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 4px; }
.mc-val { font-family: var(--display); font-weight: 700; font-size: 26px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; line-height: 1.2; }
.mc-delta { font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; margin-top: 2px; }

/* ---- signals ---- */
.sig { display: flex; gap: 14px; padding: 8px 0; border-bottom: 1px dotted var(--rule); align-items: baseline; font-size: 14px; }
.sig:last-child { border-bottom: none; }
.badge { font-family: var(--display); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 3px; min-width: 52px; text-align: center; flex-shrink: 0; }
.badge-alert { background: var(--bearish); color: #fff; }
.badge-warning { background: #E8C983; color: #4A3608; }
.badge-info { background: #E4E8E4; color: var(--text-muted); }
.sig-commodity { color: var(--text-muted); min-width: 96px; font-size: 13px; flex-shrink: 0; }

/* ---- charts & shared builder classes ---- */
.chart-box { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 12px; margin-bottom: 16px; }
.chart-empty { height: 160px; display: flex; align-items: center; justify-content: center; color: var(--text-dim); font-size: 13px; }
.subhdr { font-family: var(--display); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; margin: 4px 0 12px; }
.subhdr.togglable { cursor: pointer; user-select: none; }
.subhdr.togglable::after { content: "\25BE"; font-size: 10px; color: var(--text-dim); margin-left: 8px; }
.subhdr.togglable.closed::after { content: "\25B8"; }
.subhdr.togglable.closed + .sub-body { display: none; }
.divider { border: none; border-top: 1px dotted var(--rule); margin: 20px 0; }
.caption { font-size: 12px; color: var(--text-muted); margin-top: 4px; margin-bottom: 12px; }

/* ---- alerts ---- */
.alert { padding: 10px 16px; border-radius: 4px; font-size: 13px; margin-bottom: 12px; border-left: 3px solid; }
.alert-ok { background: rgba(31,122,61,0.07); border-color: var(--bullish); color: var(--bullish); }
.alert-warn { background: rgba(168,115,10,0.08); border-color: var(--warning); color: var(--warning); }
.alert-err { background: rgba(194,59,46,0.07); border-color: var(--bearish); color: var(--bearish); }
.alert-info { background: rgba(47,93,143,0.07); border-color: var(--info); color: var(--info); }

/* ---- tabs ---- */
.tabs { display: flex; gap: 0; border-bottom: 1px solid var(--rule); margin-bottom: 18px; }
.tab { padding: 8px 16px; font-size: 13px; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent; transition: color 0.1s; }
.tab:hover { color: var(--ink); }
.tab.active { color: var(--ink); font-weight: 600; border-bottom-color: var(--green); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ---- tables ---- */
.dtable { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
.dtable th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); padding: 8px 12px; border-bottom: 1px solid var(--rule-heavy); }
.dtable td { padding: 8px 12px; border-bottom: 1px solid var(--rule); }

/* ---- briefing ---- */
.briefing { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 20px; font-family: var(--mono); font-size: 12px; line-height: 1.7; white-space: pre-wrap; overflow-x: auto; }

/* ---- collapsible ---- */
details { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; margin-bottom: 16px; }
details summary { padding: 12px 16px; font-size: 13px; font-weight: 600; cursor: pointer; list-style: none; }
details summary::before { content: "\25B6"; font-size: 10px; margin-right: 8px; color: var(--text-dim); display: inline-block; transition: transform 0.15s; }
details[open] summary::before { transform: rotate(90deg); }
details .det-content { padding: 0 16px 16px; }

/* ---- misc ---- */
.dl { display: inline-flex; align-items: center; gap: 6px; color: var(--green); text-decoration: none; font-size: 13px; font-weight: 500; margin-right: 16px; }
.dl:hover { text-decoration: underline; }
.footer { padding-top: 24px; font-size: 12px; color: var(--text-muted); }

@media (max-width: 768px) {
  .page { padding: 20px 16px 48px; }
  .masthead { flex-direction: column; align-items: flex-start; gap: 8px; }
  .mast-meta { margin-left: 0; text-align: left; }
  .legs, .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="page">

<header class="masthead">
  <h1>Mirror<br><em>Market</em></h1>
  <div class="mast-meta">
    <div class="day">{{ masthead.day_line }}</div>
    <div>Generated {{ generated_at }} · {{ masthead.fresh_count }}/{{ masthead.total_layers }} layers fresh</div>
    <div>Soy complex + competing crops · all prices USD/MT</div>
  </div>
</header>
{% if masthead.stale_layers %}
<div class="stale-note"><b>Stale:</b>
  {%- for s in masthead.stale_layers %} {{ s.name }} ({{ s.age }}){{ "," if not loop.last }}{% endfor %} — everything else current.
</div>
{% endif %}

<nav class="index-nav">
  {% for s in sections %}
  <a href="#{{ s.id }}"><span class="no">{{ s.no }}</span>{{ s.name }}</a>
  {% endfor %}
  <a href="players.html" style="margin-left:auto; color:var(--green); font-weight:500;">Players &rarr;</a>
</nav>

{# ================================================================ #}
{# 01 — THE COMPLEX OVERNIGHT                                       #}
{# ================================================================ #}
<section id="overnight">
  <div class="sec-head"><span class="sec-no">01</span><h2>The Complex Overnight</h2><span class="why">first look — where did we open</span></div>
  {% if command_center %}
  <div class="legs">
    {% for leg in command_center.legs %}
    <div class="leg">
      <div class="name" style="color: {{ leg.color }}">{{ leg.name }}</div>
      <div class="px num">{{ leg.price }}<small> $/MT</small></div>
      <div class="chg num {{ leg.chg_class }}">{{ leg.daily_chg }} today</div>
      <div class="sub">
        <span>RSI <span class="num{% if leg.rsi_class %} {{ leg.rsi_class }}{% endif %}">{{ leg.rsi }}</span></span>
        <span class="{{ leg.trend_class }}">{{ leg.trend }}</span>
        <span>Vol {{ leg.volatility }}</span>
        {% if leg.as_of %}<span>as of {{ leg.as_of }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="grid grid-4">
    {% for m in command_center.key_metrics %}
    <div class="mc">
      <div class="mc-label">{{ m.label }}</div>
      <div class="mc-val num {{ m.val_class }}">{{ m.value }}</div>
      <div class="mc-delta {{ m.delta_class }}">{{ m.delta }}</div>
      {% if m.as_of %}<div class="caption">as of {{ m.as_of }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="alert alert-warn">No price data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 02 — WHAT FIRED                                                  #}
{# ================================================================ #}
<section id="signals">
  <div class="sec-head"><span class="sec-no">02</span><h2>What Fired</h2>
    <span class="why">signals by severity{% if command_center and command_center.signals %} — {{ command_center.signals|length }} active{% endif %}</span>
  </div>
  {% if command_center and command_center.signals %}
  {% for sig in command_center.signals %}
  <div class="sig">
    <span class="badge badge-{{ sig.severity }}">{{ sig.severity_label }}</span>
    <span class="sig-commodity">{{ sig.commodity }}</span>
    <span>{{ sig.message }}</span>
  </div>
  {% endfor %}
  {% else %}
  <div class="alert alert-ok">No active signals — quiet tape.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 03 — CRUSH & RELATIVE VALUE                                      #}
{# ================================================================ #}
<section id="relative-value">
  <div class="sec-head"><span class="sec-no">03</span><h2>Crush &amp; Relative Value</h2><span class="why">is processing paying · where is Brazil</span></div>
  {% if relative_value %}
  {{ relative_value | safe }}
  {% else %}
  <div class="alert alert-warn">No relative value data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 04 — SUPPLY & DEMAND                                             #}
{# ================================================================ #}
<section id="supply-demand">
  <div class="sec-head"><span class="sec-no">04</span><h2>Supply &amp; Demand</h2><span class="why">WASDE · CONAB · exports · emerging markets</span></div>
  {% if supply or demand or emerging_markets %}
  <div class="tabs" data-tabgroup="sd">
    <div class="tab active" data-tab="sd-1">Soy Complex</div>
    <div class="tab" data-tab="sd-2">Competing Crops</div>
    <div class="tab" data-tab="sd-3">Emerging Markets</div>
  </div>

  <div class="tab-panel active" data-tabpanel="sd-1">
    {% if supply %}
    {% if supply.wasde_html %}
    <div class="subhdr">WASDE Monthly Estimates</div>
    {{ supply.wasde_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.stocks_to_use_html %}
    <div class="subhdr">Stocks-to-Use (US balance sheet)</div>
    {{ supply.stocks_to_use_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.conab_html %}
    <div class="subhdr">CONAB vs USDA (Brazil)</div>
    {{ supply.conab_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if supply.crop_progress_html %}
    <div class="subhdr">Crop Progress &amp; Condition</div>
    {{ supply.crop_progress_html | safe }}
    <hr class="divider">
    {% endif %}
    {% endif %}
    {% if demand %}
    {% if demand.china_html %}
    <div class="subhdr">China Buying Pace</div>
    {{ demand.china_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if demand.export_sales_html %}
    <div class="subhdr">Export Sales</div>
    {{ demand.export_sales_html | safe }}
    <hr class="divider">
    {% endif %}
    {% if demand.biofuel_html %}
    <div class="subhdr">Biofuel &amp; Energy</div>
    {{ demand.biofuel_html | safe }}
    {% endif %}
    {% endif %}
  </div>

  <div class="tab-panel" data-tabpanel="sd-2">
    {% if supply and supply.competing_html %}
    {{ supply.competing_html | safe }}
    {% else %}
    <div class="chart-empty">No competing crop data available</div>
    {% endif %}
  </div>

  <div class="tab-panel" data-tabpanel="sd-3">
    {% if emerging_markets %}
    {{ emerging_markets | safe }}
    {% else %}
    <div class="chart-empty">No emerging markets data available</div>
    {% endif %}
  </div>
  {% else %}
  <div class="alert alert-warn">No supply/demand data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 05 — RISK MONITOR                                                #}
{# ================================================================ #}
<section id="risk">
  <div class="sec-head"><span class="sec-no">05</span><h2>Risk Monitor</h2><span class="why">currencies · positioning · weather</span></div>
  {% if risk_monitor %}
  {{ risk_monitor | safe }}
  {% else %}
  <div class="alert alert-warn">No risk data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 06 — FORWARD CURVES                                              #}
{# ================================================================ #}
<section id="forward-curves">
  <div class="sec-head"><span class="sec-no">06</span><h2>Forward Curves</h2><span class="why">contango or backwardation — what the term structure says</span></div>
  {% if forward_curves %}
  {{ forward_curves | safe }}
  {% else %}
  <div class="alert alert-warn">No forward curve data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 07 — SEASONAL                                                    #}
{# ================================================================ #}
<section id="seasonal">
  <div class="sec-head"><span class="sec-no">07</span><h2>Seasonal</h2><span class="why">current price vs the historical norm for this month</span></div>
  {% if seasonal %}
  {{ seasonal | safe }}
  {% else %}
  <div class="alert alert-warn">No seasonal data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 08 — TECHNICALS                                                  #}
{# ================================================================ #}
<section id="technicals">
  <div class="sec-head"><span class="sec-no">08</span><h2>Technicals</h2><span class="why">the deep charts — candles, RSI, MACD</span></div>
  {% if technicals %}
  <div class="alert alert-info" style="margin-bottom: 16px;">
    Charts use the yfinance front-month series. On contract roll days the underlying contract changes, which can introduce artificial price gaps; signals within ±3 trading days of a roll are demoted to <em>info</em> severity.
  </div>
  <div class="tabs" data-tabgroup="tech">
    {% for leg in technicals %}
    <div class="tab{% if loop.first %} active{% endif %}" data-tab="tech-{{ loop.index }}">{{ leg.name }}</div>
    {% endfor %}
  </div>
  {% for leg in technicals %}
  <div class="tab-panel{% if loop.first %} active{% endif %}" data-tabpanel="tech-{{ loop.index }}">
    <div class="chart-box">{{ leg.chart_html | safe }}</div>
    {% if leg.signals %}
    {% for sig in leg.signals %}
    <div class="sig">
      <span class="badge badge-{{ sig.severity }}">{{ sig.severity_label }}</span>
      <span>{{ sig.message }}</span>
    </div>
    {% endfor %}
    {% endif %}
    {% if leg.csv_uri %}
    <div style="margin-top: 12px;"><a class="dl" href="{{ leg.csv_uri }}" download="{{ leg.name }}.csv">&#8595; Download CSV</a></div>
    {% endif %}
  </div>
  {% endfor %}
  {% else %}
  <div class="alert alert-warn">No technical data available.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 09 — THE FULL BRIEFING                                           #}
{# ================================================================ #}
<section id="briefing">
  <div class="sec-head"><span class="sec-no">09</span><h2>The Full Briefing</h2><span class="why">the complete daily report, in text</span></div>
  {% if briefing_text %}
  <div class="briefing">{{ briefing_text }}</div>
  {% if briefing_uri %}
  <div style="margin-top: 16px;">
    <a class="dl" href="{{ briefing_uri }}" download="mirror_market_briefing.txt">&#8595; Download briefing as TXT</a>
  </div>
  {% endif %}
  {% if health_html %}
  <details style="margin-top: 16px;">
    <summary>Data Health Check</summary>
    <div class="det-content">{{ health_html | safe }}</div>
  </details>
  {% endif %}
  {% else %}
  <div class="alert alert-warn">No briefing data. Run the pipeline first.</div>
  {% endif %}
</section>

{# ================================================================ #}
{# 10 — ABOUT THE DATA                                              #}
{# ================================================================ #}
<section id="about">
  <div class="sec-head"><span class="sec-no">10</span><h2>About the Data</h2><span class="why">sources · methodology · units</span></div>

  <details>
    <summary>Data Sources (21 Layers)</summary>
    <div class="det-content">
    <table class="dtable">
      <thead>
        <tr><th>Layer</th><th>Source</th><th>Frequency</th><th>Coverage</th></tr>
      </thead>
      <tbody>
        <tr><td>1</td><td>Yahoo Finance (CME/CBOT/ICE)</td><td>Daily</td><td>11 commodity futures</td></tr>
        <tr><td>2</td><td>USDA NASS QuickStats</td><td>Annual + Weekly</td><td>US soybean production, crop progress</td></tr>
        <tr><td>3</td><td>Federal Reserve (FRED)</td><td>Daily/Monthly</td><td>Dollar index, CPI, rates, yields</td></tr>
        <tr><td>4</td><td>CFTC (COT Reports)</td><td>Weekly</td><td>10 commodities positioning</td></tr>
        <tr><td>5</td><td>Open-Meteo</td><td>Daily + 7d forecast</td><td>24 growing regions, 6 continents</td></tr>
        <tr><td>6</td><td>USDA FAS (PSD)</td><td>Monthly</td><td>8 commodities x 27 countries</td></tr>
        <tr><td>7</td><td>Yahoo Finance (FX)</td><td>Daily</td><td>13 currency pairs</td></tr>
        <tr><td>8</td><td>World Bank Pink Sheet</td><td>Monthly</td><td>Robusta, Palm Oil benchmarks</td></tr>
        <tr><td>9</td><td>AKShare (DCE)</td><td>Daily</td><td>5 Chinese futures contracts</td></tr>
        <tr><td>10</td><td>USDA FAS (Export Sales)</td><td>Weekly</td><td>6 commodities, top buyers</td></tr>
        <tr><td>11</td><td>Yahoo Finance (Contracts)</td><td>Daily</td><td>Forward curves, 10 commodities</td></tr>
        <tr><td>12</td><td>USDA WASDE</td><td>Monthly</td><td>Supply/demand forecasts</td></tr>
        <tr><td>13</td><td>EIA</td><td>Weekly/Monthly</td><td>Ethanol, biodiesel, diesel</td></tr>
        <tr><td>14</td><td>USDA (Crush + Inspections)</td><td>Monthly/Weekly</td><td>Soybean crush, export inspections</td></tr>
        <tr><td>15</td><td>CONAB</td><td>Monthly + Weekly</td><td>Brazil crop estimates + PR farmgate prices</td></tr>
        <tr><td>16</td><td>data.gov.in (Agmarknet)</td><td>Daily</td><td>India mandi soybean price (MP median)</td></tr>
        <tr><td>17</td><td>CEPEA via Notícias Agrícolas</td><td>Daily</td><td>Brazil farm-gate soy indicator</td></tr>
        <tr><td>18</td><td>JSE SAFEX</td><td>Daily</td><td>South Africa soy prices</td></tr>
        <tr><td>19</td><td>AgRural</td><td>Daily</td><td>Paranaguá FOB port price</td></tr>
        <tr><td>20</td><td>USDA AMS</td><td>Daily</td><td>CIF NOLA Gulf export bids</td></tr>
        <tr><td>21</td><td>MAGyP (Argentina)</td><td>Daily</td><td>Official FOB export values — beans, oil, meal</td></tr>
      </tbody>
    </table>
    </div>
  </details>

  {% if freshness_items %}
  <details>
    <summary>Layer Freshness ({{ masthead.fresh_count }}/{{ masthead.total_layers }} fresh)</summary>
    <div class="det-content">
    <table class="dtable">
      <thead>
        <tr><th>Layer</th><th>Status</th><th>Last Success</th></tr>
      </thead>
      <tbody>
        {% for item in freshness_items %}
        <tr>
          <td>{{ item.name }}</td>
          <td><span class="{% if item.status == 'fresh' %}up{% elif item.status == 'old' %}down{% else %}muted{% endif %}">{{ item.status }}</span></td>
          <td class="num">{{ item.age }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}

  <details>
    <summary>Analysis Methodology</summary>
    <div class="det-content">
    <table class="dtable">
      <thead><tr><th>Indicator</th><th>Parameters</th><th>What It Detects</th></tr></thead>
      <tbody>
        <tr><td>Simple Moving Average</td><td>20 / 50 / 200 day</td><td>Trend direction at three timeframes</td></tr>
        <tr><td>RSI</td><td>14-day, Wilder smoothing</td><td>Overbought (&gt;70) / Oversold (&lt;30)</td></tr>
        <tr><td>MACD</td><td>12 / 26 / 9</td><td>Momentum shifts and trend strength</td></tr>
        <tr><td>Bollinger Bands</td><td>20-day, 2 std</td><td>Volatility compression and breakouts</td></tr>
        <tr><td>Crush Spread</td><td>Oil*11 + Meal*2.2 - Beans</td><td>Processing margin profitability</td></tr>
        <tr><td>Forward Curve</td><td>Sequential months</td><td>Contango / backwardation structure</td></tr>
        <tr><td>Seasonal</td><td>Historical monthly avg</td><td>Current vs historical norms</td></tr>
      </tbody>
    </table>
    </div>
  </details>

  <div class="footer">
    All prices in <strong>USD per metric ton (USD/MT)</strong>; native exchange units are converted at the display layer.
    Mirror Market is a project by Philip Bergman. Data sourced from free public APIs. Not financial advice; all data delayed and provided as-is.
    <br><br>
    <a class="dl" href="https://github.com/philipbergman6-glitch/Mirror-Market" target="_blank">View source on GitHub</a>
  </div>
</section>

</div>

<script>
// Collapsible sections — click a numbered header to open/close
document.querySelectorAll('section').forEach(sec => {
  const head = sec.querySelector('.sec-head');
  if (!head) return;
  const chev = document.createElement('span');
  chev.className = 'chev';
  chev.textContent = '▾';
  head.appendChild(chev);
  const body = document.createElement('div');
  body.className = 'sec-body';
  while (head.nextSibling) body.appendChild(head.nextSibling);
  sec.appendChild(body);
  head.addEventListener('click', () => {
    sec.classList.toggle('collapsed');
    if (!sec.classList.contains('collapsed')) window.dispatchEvent(new Event('resize'));
  });
});

// Collapsible sub-categories — every .subhdr toggles the content that follows it
document.querySelectorAll('.sec-body .subhdr').forEach(h => {
  const wrap = document.createElement('div');
  wrap.className = 'sub-body';
  let n = h.nextSibling;
  while (n && !(n.nodeType === 1 && n.classList && n.classList.contains('subhdr'))) {
    const next = n.nextSibling;
    wrap.appendChild(n);
    n = next;
  }
  h.after(wrap);
  h.classList.add('togglable');
  h.addEventListener('click', () => {
    h.classList.toggle('closed');
    if (!h.classList.contains('closed')) window.dispatchEvent(new Event('resize'));
  });
});

// Index nav — jumping to a collapsed section reopens it
document.querySelectorAll('.index-nav a').forEach(a => {
  a.addEventListener('click', () => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target && target.classList.contains('collapsed')) {
      target.classList.remove('collapsed');
      window.dispatchEvent(new Event('resize'));
    }
  });
});

// Tab switching
document.querySelectorAll('.tabs').forEach(tabBar => {
  tabBar.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const group = tabBar.dataset.tabgroup;
      tabBar.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const panelId = tab.dataset.tab;
      document.querySelectorAll('[data-tabpanel^="' + group + '-"]').forEach(p => p.classList.remove('active'));
      document.querySelector('[data-tabpanel="' + panelId + '"]').classList.add('active');
      window.dispatchEvent(new Event('resize'));  // let Plotly reflow charts in newly shown panels
    });
  });
});
</script>
</body>
</html>
