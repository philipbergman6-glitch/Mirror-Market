{#
  Base template — owns <head> entirely (M8 #150).

  Before this existed, dashboard.html.j2 and players.html.j2 each carried their
  own font tags, their own Plotly tag and their own copy of the DESIGN.md
  palette: the design system was already duplicated across the *two* pages that
  existed. One <head> owner kills that, and is the same mechanism that gives
  every page the identical masthead and market nav.

  CSS stays inline rather than moving to docs/assets/mirror.css: it is ~5 KB
  against a multi-MB page, so a second request and a cache-busting problem buy
  nothing.

  Blocks a page fills:
    title       <title> text
    head_extra  page-specific <head> tags (Plotly, etc.)
    page_css    page-specific rules, appended after the shared core
    brand       masthead wordmark (defaults to Mirror/Market)
    mast_meta   right-hand masthead column
    prenav      anything between the masthead and the market nav (stale note)
    subnav      the page's own section-anchor bar, under the market nav
    content     the page body inside .page
    scripts     page-specific <script> tags before </body>

  `root` is the relative prefix back to docs/ ("" for docs/index.html, "../"
  for docs/markets/<slug>.html). Pages sit at two depths and the nav is
  identical on all of them, so every internal href is prefixed with it. See
  app.markets.relative_root().
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="mirror-market-generated-at" content="{{ generated_at_iso|default('') }}">
<meta name="mirror-market-layer-count" content="{{ production_layers|default([])|length }}">
<meta name="qa-overflow" content="pending">
<title>{% block title %}Mirror Market{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
{% block head_extra %}{% endblock %}
<style>
:root {
  --paper: #FAFAF7;
  --card: #FFFFFF;
  --rule: #D8DCD8;
  --rule-heavy: #191C1A;
  --ink: #191C1A;
  --green: #2D6A4F;
  --green-light: #2D6A4F;
  --text: #191C1A;
  --text-muted: #5D6660;
  --text-dim: #9BA39E;
  --bullish: #1F7A3D;
  --bearish: #C23B2E;
  --warning: #A8730A;
  --info: #2F5D8F;
  --soybean: #8B6914;
  --soy-oil: #B05E10;
  --soy-meal: #8A5A2B;
  --font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --display: 'Archivo', sans-serif;
  --mono: 'IBM Plex Mono', 'SF Mono', monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { background: var(--paper); color: var(--ink); font-family: var(--font); font-size: 14px; line-height: 1.45; }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.up { color: var(--bullish); }
.down { color: var(--bearish); }
.muted { color: var(--text-muted); }

.page { max-width: 1180px; min-width: 0; margin: 0 auto; padding: 32px 32px 64px; }

/* ---- masthead ---- */
.masthead { border-bottom: 3px solid var(--rule-heavy); padding-bottom: 18px; display: flex; align-items: flex-end; gap: 24px; }
.masthead > *, section, .mc, .chart-box { min-width: 0; }
.masthead h1 { font-family: var(--display); font-weight: 800; font-size: 42px; letter-spacing: -0.03em; line-height: 1; overflow-wrap: anywhere; }
.masthead h1 em { font-style: normal; color: var(--green); }
.mast-meta { margin-left: auto; max-width: 100%; text-align: right; font-size: 12px; color: var(--text-muted); overflow-wrap: anywhere; }
.mast-meta .day { font-family: var(--display); font-weight: 700; font-size: 14px; color: var(--ink); text-transform: uppercase; letter-spacing: 0.06em; }
.mast-meta a { color: var(--green); text-decoration: none; font-weight: 500; }
.mast-meta a:hover { text-decoration: underline; }
.mast-critical { color: var(--bearish); font-weight: 600; }
.stale-note { font-size: 12px; color: var(--warning); border-bottom: 1px solid var(--rule); padding: 8px 0; overflow-wrap: anywhere; }
.stale-note b { font-weight: 600; }

/* ---- market nav ----
   DESIGN.md :63/:66 — a second thin bar in the masthead, above the page's own
   section-anchor bar, two bars in the same visual family. Explicitly NOT a
   sidebar: that is what the 2026-07-28 redesign removed.
   Order is registry key order = role in the trade, and it is the same
   declaration M2's headline ledger reads, so nav and ledger cannot disagree.
   Stubs are dimmed; pages and briefs render identically. Every market appears
   in every tier, or the reader cannot tell the market exists. */
.market-nav { display: flex; gap: 18px; padding: 9px 0; border-bottom: 1px solid var(--rule); overflow-x: auto; white-space: nowrap; align-items: baseline; }
.market-nav .mn-label { font-family: var(--display); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-dim); }
.market-nav > * { flex: 0 0 auto; }
.market-nav a { text-decoration: none; color: var(--text-muted); font-size: 12px; font-weight: 500; transition: color 0.1s; }
.market-nav a:hover { color: var(--ink); }
.market-nav a.current { color: var(--ink); font-weight: 600; border-bottom: 2px solid var(--green); padding-bottom: 2px; }
.market-nav a.stub { color: var(--text-dim); }
.market-nav .mn-end { margin-left: auto; color: var(--green); font-weight: 500; }

/* ---- index nav (per-page section anchors) ---- */
.index-nav { position: sticky; top: 0; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--rule); display: flex; gap: 20px; padding: 10px 0; overflow-x: auto; white-space: nowrap; }
.index-nav a { flex: 0 0 auto; text-decoration: none; color: var(--text-muted); font-size: 12px; transition: color 0.1s; }
.index-nav a:hover { color: var(--ink); }
.index-nav a .no { font-family: var(--mono); font-size: 11px; color: var(--green); margin-right: 4px; }

/* ---- footer ---- */
.footer { padding-top: 24px; font-size: 12px; color: var(--text-muted); }
.footer a { color: var(--green); text-decoration: none; font-weight: 500; }
.footer a:hover { text-decoration: underline; }


/* ---- shared components (M18 #214) ----
   Cards, alerts, signal badges and sub-headers are rendered by BOTH the
   headline sections and the nine market blocks, so they live with the palette
   in the one <head> owner. They were dashboard-only while the dashboard was
   the only page that had components; a second copy in _market_css.html.j2 is
   exactly the drift _base exists to prevent. */
.grid { display: grid; gap: 16px; margin-bottom: 16px; align-items: start; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.mc { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; }
.mc-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 4px; }
.mc-val { font-family: var(--display); font-weight: 700; font-size: 26px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; line-height: 1.2; }
.mc-delta { font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; margin-top: 2px; }

.sig { display: flex; gap: 14px; padding: 8px 0; border-bottom: 1px dotted var(--rule); align-items: baseline; font-size: 14px; }
.sig:last-child { border-bottom: none; }
.badge { font-family: var(--display); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 3px; min-width: 52px; text-align: center; flex-shrink: 0; }
.badge-alert { background: var(--bearish); color: #fff; }
.badge-warning { background: #E8C983; color: #4A3608; }
.badge-info { background: #E4E8E4; color: var(--text-muted); }
.sig-commodity { color: var(--text-muted); min-width: 96px; font-size: 13px; flex-shrink: 0; }

.chart-box { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 12px; margin-bottom: 16px; }
.chart-empty { height: 160px; display: flex; align-items: center; justify-content: center; color: var(--text-dim); font-size: 13px; }
.subhdr { font-family: var(--display); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; margin: 4px 0 12px; }
.divider { border: none; border-top: 1px dotted var(--rule); margin: 20px 0; }
.caption { font-size: 12px; color: var(--text-muted); margin-top: 4px; margin-bottom: 12px; }

.alert { padding: 10px 16px; border-radius: 4px; font-size: 13px; margin-bottom: 12px; border-left: 3px solid; }
.alert-ok { background: rgba(31,122,61,0.07); border-color: var(--bullish); color: var(--bullish); }
.alert-warn { background: rgba(168,115,10,0.08); border-color: var(--warning); color: var(--warning); }
.alert-err { background: rgba(194,59,46,0.07); border-color: var(--bearish); color: var(--bearish); }
.alert-info { background: rgba(47,93,143,0.07); border-color: var(--info); color: var(--info); }

.dtable { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
.dtable th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); padding: 8px 12px; border-bottom: 1px solid var(--rule-heavy); }
.dtable td { padding: 8px 12px; border-bottom: 1px solid var(--rule); }
.dtable th.num, .dtable td.num { text-align: right; }
.dtable td.strong { font-weight: 600; }
.table-scroll { width: 100%; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.table-scroll > .dtable { min-width: 760px; }

/* ---- quote-kind label (M3 #145 constraint 4) ----
   Board settlements, physical assessments, administered minimums and weekly
   assessments are different animals; collapsing them into one "price" label is
   the easiest way to make the product dishonest. Rendered by the market blocks
   AND by the ledger on both surfaces, so it belongs with the palette. */
.kind { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 7px; border-radius: 3px; background: #E4E8E4; color: var(--text-muted); }

/* ---- propagation ledger (M3 #145 / M12 #161) ----
   The state pill is the point of the surface: a market that has not printed
   must never read as a market that printed unchanged. `repriced` is the only
   affirmative colour; `no print since` is deliberately quiet unless it is past
   the gap that is normal for that leg, and `dark` is loud. `out of cadence`
   (Europe on the headline) is neither an outage nor a print, so it is outlined
   rather than filled — it carries no value at all. */
.ledger .lrow.own td { background: rgba(45,106,79,0.045); }
.ledger .lrow.ref td { color: var(--text-muted); }
.ledger .caption { margin: 2px 0 0; font-size: 11px; }
.pill { font-family: var(--display); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 8px; border-radius: 3px; white-space: nowrap; }
.pill-repriced { background: rgba(45,106,79,0.12); color: var(--green); }
.pill-no_print_since { background: #E4E8E4; color: var(--text-muted); }
.pill-no_print_since.overdue { background: #E8C983; color: #4A3608; }
.pill-dark { background: var(--bearish); color: #fff; }
.pill-out_of_cadence { background: transparent; border: 1px solid var(--rule-heavy); color: var(--text-dim); }
.fx-tag { font-family: var(--mono); font-size: 10px; font-weight: 600; padding: 1px 5px; border-radius: 3px; background: rgba(47,93,143,0.12); color: var(--info); cursor: help; }
.ledger-rule { display: flex; gap: 10px; align-items: baseline; font-size: 13px; color: var(--text-muted); margin-bottom: 8px; flex-wrap: wrap; }
.rule-tag { font-family: var(--display); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 3px; background: var(--green); color: #fff; }
.ledger-good { font-size: 12px; color: var(--text-dim); margin-bottom: 10px; }
.ledger-note { font-size: 12px; color: var(--text-muted); border-left: 2px solid var(--rule-heavy); padding-left: 12px; margin-top: 12px; }

@media (max-width: 768px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .page { padding: 20px 16px 48px; }
  .masthead { flex-direction: column; align-items: flex-start; gap: 8px; }
  .masthead h1 { font-size: clamp(32px, 11vw, 42px); }
  .mast-meta { margin-left: 0; text-align: left; }
  .market-nav .mn-end { margin-left: 0; }
}
{% block page_css %}{% endblock %}
</style>
</head>
<body>
<div class="page">

<header class="masthead">
  {% block brand %}<h1>Mirror<br><em>Market</em></h1>{% endblock %}
  <div class="mast-meta">
    {% block mast_meta %}{% endblock %}
  </div>
</header>
{% block prenav %}{% endblock %}

<nav class="market-nav">
  <span class="mn-label">Markets</span>
  <a href="{{ root }}index.html"{% if current_page == 'headline' %} class="current"{% endif %}>Headline</a>
  {% for m in market_nav %}
  {%- set cls = ('current' if current_market == m.slug else '') ~ (' stub' if m.tier == 'stub' else '') %}
  <a href="{{ m.href }}"{% if cls.strip() %} class="{{ cls.strip() }}"{% endif %}>{{ m.name }}</a>
  {% endfor %}
  <a href="{{ root }}players.html" class="mn-end{% if current_page == 'players' %} current{% endif %}">Players &rarr;</a>
</nav>
{% block subnav %}{% endblock %}

{% block content %}{% endblock %}

</div>
{% block scripts %}{% endblock %}
<script>
(() => {
  const report = () => {
    const root = document.documentElement;
    const meta = document.querySelector('meta[name="qa-overflow"]');
    const overflow = Math.max(root.scrollWidth, document.body.scrollWidth) - root.clientWidth;
    meta.content = overflow > 1 ? `overflow:${overflow}` : 'ok';
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(report));
  else requestAnimationFrame(report);
})();
</script>
</body>
</html>
